@{
    ViewData["Title"] = "Active vs Inactive Students";
}

<h2>Active vs Inactive Students</h2>
<div style="width: 100%; max-width: 550px; margin: auto;">
    <canvas id="activeChart"></canvas>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    async function loadActiveChart() {
        const response = await fetch('/Student/Chart');
        const students = await response.json();

        const activeCount = students.filter(s => s.isActive).length;
        const inactiveCount = students.filter(s => !s.isActive).length;

        const ctx = document.getElementById('activeChart').getContext('2d');
        new Chart(ctx, {
            type: 'pie',
            data: {
                labels: ['Active', 'Inactive'],
                datasets: [{
                    label: 'Active Status',
                    data: [activeCount, inactiveCount],
                    backgroundColor: [
                        'rgba(75, 192, 192, 0.6)',
                        'rgba(255, 99, 132, 0.6)'
                    ],
                    borderColor: [
                        'rgba(75, 192, 192, 1)',
                        'rgba(255, 99, 132, 1)'
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true
            }
        });
    }

    loadActiveChart();
</script>
