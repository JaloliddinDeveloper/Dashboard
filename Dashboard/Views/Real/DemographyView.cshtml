@{
    ViewData["Title"] = "Demografiya Chart";
}

<h2>O‘zbekiston Demografiyasi (2000–2025)</h2>

<div style="width:100%; max-width:950px; margin:auto;">
    <canvas id="demographyChart"></canvas>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    async function loadDemographyChart() {
        const response = await fetch('/Real/DemographyData');
        const data = await response.json();

        if (data.length === 0) {
            alert("Demografik ma'lumotlar mavjud emas!");
            return;
        }

        const labels = data.map(d => d.year);
        const populations = data.map(d => (d.population / 1_000_000).toFixed(1)); // mln ko‘rinishida
        const urban = data.map(d => d.urban);
        const rural = data.map(d => d.rural);

        const ctx = document.getElementById('demographyChart').getContext('2d');

        new Chart(ctx, {
            data: {
                labels: labels,
                datasets: [
                    {
                        type: 'bar',
                        label: 'Aholi soni (mln)',
                        data: populations,
                        backgroundColor: 'rgba(54, 162, 235, 0.6)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 1,
                        yAxisID: 'y',
                    },
                    {
                        type: 'line',
                        label: 'Shahar aholisi (%)',
                        data: urban,
                        borderColor: 'rgba(255, 99, 132, 1)',
                        backgroundColor: 'rgba(255, 99, 132, 0.2)',
                        tension: 0.4,
                        yAxisID: 'y1',
                        fill: false,
                        pointRadius: 5,
                        pointBackgroundColor: 'white',
                        pointBorderColor: 'rgba(255, 99, 132, 1)'
                    },
                    {
                        type: 'line',
                        label: 'Qishloq aholisi (%)',
                        data: rural,
                        borderColor: 'rgba(75, 192, 192, 1)',
                        backgroundColor: 'rgba(75, 192, 192, 0.2)',
                        tension: 0.4,
                        yAxisID: 'y1',
                        fill: false,
                        pointRadius: 5,
                        pointBackgroundColor: 'white',
                        pointBorderColor: 'rgba(75, 192, 192, 1)'
                    }
                ]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'top',
                        labels: { font: { size: 13 } }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                if (context.dataset.label.includes("Aholi")) {
                                    return context.parsed.y + " mln";
                                } else {
                                    return context.parsed.y + "%";
                                }
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        type: 'linear',
                        position: 'left',
                        title: {
                            display: true,
                            text: 'Aholi (mln)'
                        }
                    },
                    y1: {
                        type: 'linear',
                        position: 'right',
                        title: {
                            display: true,
                            text: 'Ulush (%)'
                        },
                        grid: {
                            drawOnChartArea: false
                        },
                        min: 0,
                        max: 100
                    },
                    x: {
                        title: {
                            display: true,
                            text: "Yil"
                        }
                    }
                }
            }
        });
    }

    loadDemographyChart();
</script>
